API_ID=123456
API_HASH=replace_with_bot_api_hash
BOT_TOKEN=123456:replace_with_bot_token
ADMIN_USER_ID=123456789
# Generated automatically by the interactive Linux administrator login.
SESSION_STRING=
SESSION_ENCRYPTION_KEY=generate_with_dloader_menu
ENVIRONMENT=production
DATABASE_URL=sqlite:////var/lib/dloader/downloads.db
DATA_DIR=/var/lib/dloader
DOWNLOAD_DIR=/var/lib/dloader/downloads
LOG_DIR=/var/log/dloader
MAX_CONCURRENT_DOWNLOADS=4
MAX_USER_TASKS=2
MAX_ACTIVE_USER_SESSIONS=50
SESSION_IDLE_TIMEOUT=1800
AUTH_FLOW_TIMEOUT=600
AUTH_ATTEMPTS_PER_HOUR=8
MAX_PENDING_AUTH=25
BATCH_SIZE=3
FLOOD_WAIT_DELAY=2
MAX_FILE_SIZE=2000000000
LOG_LEVEL=INFO
