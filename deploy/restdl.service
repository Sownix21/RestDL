[Unit]
Description=RestrictiveDL Telegram downloader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=restdl
Group=restdl
WorkingDirectory=/opt/restdl
EnvironmentFile=/etc/restdl/restdl.env
ExecStart=/opt/restdl/.venv/bin/python /opt/restdl/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/restdl /var/log/restdl /opt/restdl/downloads /opt/restdl/logs

[Install]
WantedBy=multi-user.target
